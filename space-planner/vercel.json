{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/", "destination": "/dist.html" },
    { "source": "/index.html", "destination": "/dist.html" }
  ],
  "headers": [
    { "source": "/dist.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
